{
  "name": "portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "437d9cc1-6286-4b14-9b15-d6d486730a70"
    }
  ]
}
